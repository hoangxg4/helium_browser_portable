Windows Registry Editor Version 5.00

; Yandex Browser Portable — safe-first debloat set (exactly 11 values).
; Branch: HKLM\SOFTWARE\Policies\YandexBrowser (Yandex ignores the Chromium policy branch).
; Honored by the consumer build: spike P3 headed run H5 lists these as
; source=Platform, level=Mandatory on chrome://policy.
; Requires admin (double-click, or: reg import debloater.reg).

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\YandexBrowser]
; StatisticsReporting=0 — do not send usage statistics to Yandex
"StatisticsReporting"=dword:00000000
; CrashesReporting=0 — do not upload crash reports
"CrashesReporting"=dword:00000000
; BackgroundModeEnabled=0 — no background/tray process after the last window closes
"BackgroundModeEnabled"=dword:00000000
; YandexAutoLaunchMode=2 — never: do not start the browser with Windows
;   (enum per design §3; spike P3 evidence: ADMX ships no YandexAutoLaunchMode entry)
"YandexAutoLaunchMode"=dword:00000002
; YandexAliceMsgDisable=1 — no Alice assistant prompts/messages
"YandexAliceMsgDisable"=dword:00000001
; NeuroNtpTools=0 — no neural/AI widgets on the new tab page
"NeuroNtpTools"=dword:00000000
; NtpNotificationsDisable=1 — no notifications on the new tab page (1 = disabled)
"NtpNotificationsDisable"=dword:00000001
; YandexButtonDisable=1 — no Yandex button/shortcut clutter in the UI
"YandexButtonDisable"=dword:00000001
; SearchSuggestEnabled=0 — no search suggestions (no network calls while typing)
"SearchSuggestEnabled"=dword:00000000
; UpdateAllowed=0 — stops browser self-update. Security rationale: the portable tree is
;   replaced deliberately from this repo's releases (version.txt = winget PackageVersion),
;   so patches arrive as reviewed re-installs instead of an unattended in-place overwrite.
;   Component/security updates stay enabled — see the 3-don't-touch list below.
"UpdateAllowed"=dword:00000000
; BackgroundUpdateAllowed=0 — no silent background update downloads
"BackgroundUpdateAllowed"=dword:00000000

; NEVER disable here (3-don't-touch):
;   SafeBrowsingProtectionLevel — phishing/malware protection
;   ComponentUpdatesEnabled / --disable-component-update — Widevine/DRM breaks
;   security updates beyond UpdateAllowed rationale
